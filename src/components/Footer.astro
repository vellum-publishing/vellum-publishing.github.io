---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="footer-brand" href="/">Vellum Publishing</a>
      <p>A focused home for publishing workflows that keep authorship, revision state, and delivery intent visible from the first draft through the final artifact.</p>
    </div>
    <nav aria-label="Product links">
      <strong>Explore</strong>
      <a href="/product/">Product</a>
      <a href="/trust/">Trust</a>
      <a href="/about/">About</a>
    </nav>
    <nav aria-label="Account links">
      <strong>Access</strong>
      <a href={site.userUrl}>User login</a>
      <a href={site.orgUrl}>Organization login</a>
      <a href={site.authUrl}>Create account</a>
    </nav>
    <nav aria-label="Project links">
      <strong>Project</strong>
      <a href={site.githubUrl}>GitHub organization</a>
      <a href={`https://github.com/vellum-publishing/vellum-publishing.github.io`}>Site source</a>
    </nav>
  </div>
  <div class="footer-base">
    <span>© 2026 Vellum Publishing</span>
    <span>Built with Astro · Static by design</span>
  </div>
</footer>
